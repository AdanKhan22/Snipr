{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snipr",
  "version": "0.1.0",
  "identifier": "com.snipr.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Snipr",
        "width": 1040,
        "height": 700,
        "minWidth": 800,
        "minHeight": 520,
        "center": true,
        "visible": false
      },
      {
        "label": "picker",
        "title": "Snipr Picker",
        "width": 580,
        "height": 440,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "center": true,
        "shadow": true
      },
      {
        "label": "prompt",
        "title": "Snipr Input",
        "width": 440,
        "height": 200,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
